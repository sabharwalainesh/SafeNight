BRIDGE_PORT=8787
# Default 127.0.0.1. Setting 0.0.0.0 exposes the bridge to your network.
BRIDGE_HOST=127.0.0.1
BRIDGE_TOKEN=change-me
SIMULATE_ALL=1

NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Optional: only if you also use the webhook path
PHOTON_WEBHOOK_SECRET=

ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_BUDDY_AGENT_ID=
ELEVENLABS_DISPATCH_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# A phone YOU control. Dispatch calls only ever go here.
DEMO_DISPATCH_NUMBER=
# Comma-separated extra numbers that must never be dialed
BLOCKED_NUMBERS=

# REQUIRED to opt in: "join <name>" is accepted only from this exact phone (E.164)
PHONE_ALEX=
PHONE_SAM=
PHONE_MAYA=
PHONE_JORDAN=

# Optional tuning
DEBOUNCE_MS=1500
CALL_DELAY_MS=45000
SIM_DELAY_MS=3000
