{
  "name": "safenight-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host 0.0.0.0",
    "preview:phone": "vite preview --host 0.0.0.0",
    "icons": "node scripts/make-icons.mjs",
    "dev:mock": "VITE_DATA_SOURCE=mock vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:mock": "tsc -p tsconfig.json --noEmit && VITE_DATA_SOURCE=mock vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "spacetimedb": "^2.14.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.7"
  }
}
