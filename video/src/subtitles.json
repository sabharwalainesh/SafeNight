    "speaker": ""
  },
  {
    "id": "17-human-handoff-2",
    "start": 147.912,
    "end": 152.088,
    "text": "The workflow tracks acknowledgment and\nkeeps unresolved needs visible",
    "type": "speech",
    "speaker": ""
  },
  {
    "id": "17-human-handoff-3",
