# SafeNight module environment variables.
#
# These are SpacetimeDB *module* env vars, not process env vars. They live in the
# database and are supplied at publish time. All are optional: when a key is
# absent the module runs the matching capability in SIMULATED mode and labels it.
#
# Two ways to supply them (never commit real values):
#
#   1. Shell, at publish time (recommended for secrets):
#        NEMOTRON_API_KEY='...' spacetime publish safenight --env-only --server local
#      --env-only updates the stored values without rebuilding or uploading the module.
#      Use the same shape without --env-only on the first publish.
#
#   2. spacetime.local.json (git-ignored), next to spacetime.json:
#        { "env": { "NEMOTRON_MODEL": "nvidia/nemotron-3.5-super-vl-120b-a12b" } }
#      Keep secrets out of spacetime.json, which is committed.
#
# Inspect what the database currently holds (prints values; owner only):
#   spacetime env list safenight --server local

# --- Nemotron (NVIDIA NIM, OpenAI-compatible chat completions with tool calling) ---
# Absent key => deterministic simulated planner; receipts carry simulated=true.
NEMOTRON_API_KEY=
# Any Nemotron model on build.nvidia.com that supports tool calling.
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Twilio (consented SMS/voice). All three required for live delivery. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- App mode: development | demo | production ---
# demo-only reducers (reset_demo, demo_fire_followup) refuse to run in production.
APP_ENV=development

# --- Web client (Vite, read from web/.env.local, these ARE process env vars) ---
# VITE_SPACETIMEDB_HOST=ws://127.0.0.1:3000
# VITE_SPACETIMEDB_DB_NAME=safenight
